# Copy to .env.local for local (non-Docker) runs, or use as the source for
# docker-compose.yml's env vars (see ../docker-compose.yml). Every value here
# has a dev-safe default baked into application.yml except JWT_SECRET and
# ADMIN_PASSWORD, which MUST be overridden outside local dev.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/kbv_education
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- JWT ---
# Generate a real secret, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-please-use-a-long-random-secret-key-32bytes-min
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Seeded SUPER_ADMIN (created on first boot if no admin exists) ---
ADMIN_EMAIL=admin@kbv.edu
ADMIN_PASSWORD=change-me-on-first-login

# --- File storage & uploads ---
STORAGE_BASE_PATH=/data/storage
STORAGE_MAX_FILE_SIZE_MB=25
MAX_FILE_SIZE=25MB
MAX_REQUEST_SIZE=150MB

# --- Server ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# --- docker-compose.yml only (ignored when running the JAR directly) ---
DB_NAME=kbv_education
API_PORT=8099
WEB_PORT=80
