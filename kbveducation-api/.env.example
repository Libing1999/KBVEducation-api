# Copy to .env.local for local (non-Docker) runs, or use as the source for
# docker-compose.yml's env vars (see ../docker-compose.yml). Every value here
# has a dev-safe default baked into application.yml except JWT_SECRET and
# ADMIN_PASSWORD, which MUST be overridden outside local dev.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/kbv_education
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- JWT ---
# Generate a real secret, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-please-use-a-long-random-secret-key-32bytes-min
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Public site address (docker-compose frontend / Caddy) ---
# Set to the public HOSTNAME (e.g. education.kbv.com) to turn on Caddy's
# automatic HTTPS. Required for the reflection voice recorder: browsers only
# expose getUserMedia/MediaRecorder on https:// (or localhost), so on a plain
# http:// deployment recording is disabled by the browser itself.
#
# Must be a hostname, NOT a bare IP - Let's Encrypt does not issue certs for
# IP addresses. With no domain of your own, sslip.io resolves a hostname to
# any IP encoded in it, and Let's Encrypt will certify it:
#   SITE_ADDRESS=143-110-184-200.sslip.io
# Leave unset to serve plain HTTP on :80 (recording stays unavailable).
SITE_ADDRESS=

# Public origin used for links in notification emails. Keep in sync with
# SITE_ADDRESS (and use https:// once HTTPS is on).
APPLICATION_URL=http://localhost

# --- Seeded SUPER_ADMIN (created on first boot if no admin exists) ---
ADMIN_EMAIL=admin@kbv.edu
ADMIN_PASSWORD=change-me-on-first-login

# --- File storage & uploads ---
STORAGE_BASE_PATH=/data/storage
STORAGE_MAX_FILE_SIZE_MB=25
MAX_FILE_SIZE=25MB
MAX_REQUEST_SIZE=150MB

# --- Email (SMTP) ---
# Optional: the admin Email Settings page can override each of these at
# runtime. With no host configured anywhere, emails are skipped (and logged
# as skipped) - never attempted.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_NAME=KBV Education
SMTP_SENDER_EMAIL=
# Public URL of the web app, used inside notification emails.
APPLICATION_URL=http://localhost:5173

# --- Secrets-at-rest encryption (SMTP password etc.) ---
# Generate a real key, e.g.: openssl rand -base64 32
ENCRYPTION_KEY=change-me-local-dev-encryption-key

# --- Server ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# --- docker-compose.yml only (ignored when running the JAR directly) ---
DB_NAME=kbv_education
API_PORT=8099
WEB_PORT=80
