
# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/kbv_education
DB_USERNAME=username-value
DB_PASSWORD=password-value

# --- JWT ---
JWT_SECRET=change-me-please-use-a-long-random-secret-key-32bytes-min
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Seeded SUPER_ADMIN ---
ADMIN_EMAIL=admin-email-value
ADMIN_PASSWORD=admin-password-value
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin

# --- File storage & uploads ---
STORAGE_BASE_PATH=
STORAGE_MAX_FILE_SIZE_MB=25
MAX_FILE_SIZE=25MB
MAX_REQUEST_SIZE=150MB

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_NAME=KBV Education
SMTP_SENDER_EMAIL=

# --- Application URL ---
APPLICATION_URL=http://localhost:5173

# --- Secrets-at-rest encryption ---
ENCRYPTION_KEY=change-me-local-dev-encryption-key

# --- AI API Keys ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Server ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Docker Compose ---
DB_NAME=kbv_education
API_PORT=8099
WEB_PORT=80